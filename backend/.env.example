# Local development default (SQLite, no server needed)
DATABASE_URL=sqlite:///./data/results.db
MAX_UPLOAD_SIZE_MB=10
MODEL_DIR=ml/artifacts

# Production (Render) — set DATABASE_URL to your Supabase PostgreSQL connection string, e.g.
# DATABASE_URL=postgresql://postgres.XXXX:[PASSWORD]@aws-0-....pooler.supabase.com:5432/postgres
