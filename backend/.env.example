# Local development default (SQLite, no server needed)
DATABASE_URL=sqlite:///./data/results.db
MAX_UPLOAD_SIZE_MB=10
MODEL_DIR=ml/artifacts

# Production (Render) — Supabase. Use the URI from:
#   Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
#
# Session pooler (RECOMMENDED for Render — IPv4, reachable), port 6543:
#   DATABASE_URL=postgresql://postgres.pgtxgxachmeatqpsbanr:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
#
# Direct connection, port 5432 — NOTE: only resolves to IPv6, which Render
# cannot reach ("Network is unreachable"). Prefer the session pooler above:
#   DATABASE_URL=postgresql://postgres:[PASSWORD]@db.pgtxgxachmeatqpsbanr.supabase.co:5432/postgres
#
# IMPORTANT: if your password contains any of these characters  @ : / # ? % space
# you MUST URL-encode them, otherwise the connection string breaks.
# e.g. password "a@b:c#" becomes  a%40b%3Ac%23
